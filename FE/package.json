{
  "name": "sports-center-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate:api": "node scripts/generate-api.mjs",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:captcha": "playwright test --config playwright.turnstile.config.ts",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:a11y": "playwright test accessibility.spec.ts",
    "check:conflicts": "node scripts/check-conflicts.mjs",
    "check:api-contract": "node ../scripts/audit-api-contract.mjs",
    "prebuild": "npm run check:conflicts",
    "verify": "npm run check:conflicts && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@zxing/browser": "^0.2.1",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
