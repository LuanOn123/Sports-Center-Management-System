# Backend local (cổng PORT trong BE/.env; mặc định 8080).
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Khi dùng Render, đổi lại thành:
# VITE_API_BASE_URL=https://sports-center-management-system.onrender.com/api/v1

# Chỉ dùng để kiểm thử giao diện VietQR khi backend sandbox chưa sẵn sàng.
# Giữ false khi dùng backend SePay Test Mode hoặc Live.
VITE_SEPAY_MOCK_MODE=false

# Public site key only. CAPTCHA is mandatory; missing configuration blocks login.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAFSemj8jOA4n9j1n

# Chỉ bật true ở FE khi BE cũng bật SEPAY_MOCK_MODE=true cho dev/demo.
# Không đặt SEPAY_API_TOKEN hoặc SEPAY_WEBHOOK_API_KEY trong FE.
