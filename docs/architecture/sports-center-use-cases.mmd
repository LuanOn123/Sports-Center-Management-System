%% SCOPE: Implemented API capability overview; see USE_CASES.md for route/role restrictions.
%% Mermaid flowchart is a use-case approximation, not native UML use-case notation.
%% Shared account operations apply to all five authenticated roles.
flowchart LR
  Guest["Guest"]
  Member["Member"]
  Coach["Coach"]
  Receptionist["Receptionist"]
  Manager["Center Manager"]
  Admin["Admin"]
  subgraph System["Sports Center Management System"]
    Access(["Register, login and reset password"])
    OwnAccount(["Own profile, password, logout, notifications and chat"])
    Catalog(["Browse paid plans and sports"])
    Course(["Find classes, register whole course, manage bookings and waitlist"])
    MemberRights(["Buy or cancel own plan, view payments and invoices"])
    Scan(["Scan class attendance QR and view own attendance"])
    Feedback(["View coach ratings; Member may submit, update or delete own rating"])
    Support(["Submit support issues"])
    Teach(["View assigned schedule, roster and limited member training profile"])
    Record(["Generate class QR and record attendance"])
    CoachChange(["Request teaching replacement"])
    FrontDesk(["Create members; sell, renew or cancel plans; collect payments and confirm refunds"])
    ReceptionAttend(["Monitor attendance, warn and report violations; facility check-in"])
    Resources(["Manage facility rooms, classes and room capabilities"])
    Scheduling(["Create, reschedule, cancel and complete sessions"])
    StaffManage(["Create facility staff and assign facility Coaches"])
    AdminReview(["Correct attendance and moderate coach feedback"])
    Assignment(["Assign class coaches and decide replacement requests"])
    Review(["Review attendance reports and penalties; correct attendance; moderate feedback"])
    Leave(["Request staff leave or Member class leave"])
    Operations(["Review leave and support issues; view audit feed"])
    FacilityReports(["View scoped revenue and membership reports"])
    GlobalAdmin(["Manage users, facilities, facility assignments, paid plans and sports"])
    GlobalReports(["View global and cross-facility reports; reconcile payments"])
    Eligibility(["Validate entitlement, quota, seats, term, penalty and schedule conflicts"])
    ScanEligibility(["Validate credential, enrollment, session window and scan-time entitlement"])
  end
