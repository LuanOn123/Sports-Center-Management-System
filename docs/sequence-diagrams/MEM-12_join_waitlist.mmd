%% SOURCE: BE/src/modules/enrollments/enrollments.service.ts
%% SOURCE: FE/src/shared/Waitlist.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
sequenceDiagram
    actor A as Member
    participant UI as WaitlistAction
    participant API as Express middleware / errorHandler
    participant C as waitlist.controller.ts
    participant S as waitlistService
    participant DB as Prisma / PostgreSQL

    A->>UI: Join waitlist for a full future session
    UI->>API: POST /api/v1/waitlist
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(MEMBER), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: joinScheduleWaitlist(req, res, next)
        activate C
        C->>S: joinWaitlist(scheduleId, memberProfileId)
        activate S
        S->>DB: Begin transaction, lock subscription / quota / class / schedule and reread eligibility
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: assertCanBook with ignoreCapacity true, then require full capacity
        S->>S: Reject existing BOOKED / COMPLETED enrollment or WAITING entry
        alt unavailable session, FREE / other eligibility failure, duplicate or seats still available
            S->>DB: Roll back transaction
            S-->>C: 400 / 403 / 404 / 409
        else business conditions satisfied
            S->>DB: waitlistEntry.create with next monotonic position and WAITING default
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S->>DB: Commit transaction
            S-->>C: Waitlist entry and position
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 201 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

