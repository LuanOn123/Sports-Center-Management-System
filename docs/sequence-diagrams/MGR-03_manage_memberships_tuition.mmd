%% USE CASE: Admin quản lý danh mục gói và học phí
%% SOURCE: BE/src/modules/membership-plans/membership-plans.service.ts
%% SOURCE: BE/src/modules/membership-plans/membership-plans.routes.ts
%% SOURCE: FE/src/features/manage/ResourcePage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Checklist prefix retained, but Center Manager is not authorized for catalog writes.
%% POST /membership-plans creates unique-name paid plans. DELETE soft-deactivates only after global ACTIVE subscription guard.
%% Updating catalog does not retroactively alter sold payment snapshots.
sequenceDiagram
    actor A as Admin
    participant UI as ResourcePage
    participant API as Express middleware / errorHandler
    participant C as plansController
    participant S as membershipPlansService
    participant DB as Prisma / PostgreSQL

    A->>UI: Edit paid membership price and terms
    UI->>API: PATCH /api/v1/membership-plans/:id
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(ADMIN), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: updatePlan(req, res, next)
        activate C
        C->>S: updatePlan(id, data)
        activate S
        S->>DB: membershipPlan.findUnique(id)
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Reject FREE system plan
        alt plan missing or tier FREE
            S-->>C: 404 / 409
        else business conditions satisfied
            S->>DB: membershipPlan.update(data)
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S-->>C: Updated paid plan catalog
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% Request validation schemas (see route evidence): UpdatePlanSchema
