%% STATUS: IMPLEMENTED
%% USE CASE: Gửi lại thông báo qua outbox
%% SOURCE: BE/src/modules/notifications/outbox.service.ts
%% SOURCE: BE/src/modules/notifications/notifications.service.ts
%% SOURCE: BE/src/server.ts
%% Outbox delivers persisted in-app Notification rows, not an invented email or socket event.
%% Current worker claims PENDING rows with CAS. Do not assume exactly-once delivery or a recovery lease for SENDING.
sequenceDiagram
    actor Timer as Server outbox timer
    participant Host as server.ts timer callback
    participant W as flushNotificationOutbox
    participant N as notificationsService
    participant DB as Prisma / PostgreSQL

    Timer->>Host: Tick every 5 seconds
    Host->>W: flushNotificationOutbox()
    activate W
    W->>DB: notificationOutbox.findMany(PENDING, availableAt due)
    DB-->>W: Due rows up to configured batch size
    loop due row
        W->>DB: CAS PENDING to SENDING
        DB-->>W: Claimed count
        opt claimed once
            W->>DB: Check target User exists
            DB-->>W: Target identity
        end
        alt another worker already claimed
            W->>W: Skip row
        else target User missing
            W->>DB: Mark outbox FAILED without creating notification
        else claimed and target exists
            W->>N: createNotification(data)
            activate N
            N->>DB: notification.create(data)
            DB-->>N: Created notification or persistence failure
            N-->>W: Delivery outcome
            deactivate N
            alt notification created
                W->>DB: Mark outbox SENT with sentAt
            else delivery failure
                W->>DB: Mark FAILED or retry PENDING with attempts and exponential backoff
            end
        end
    end
    W-->>Host: Sent count or processing error
    deactivate W
    Host-->>Timer: Logged outcome
