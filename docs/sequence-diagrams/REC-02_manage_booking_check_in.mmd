%% STATUS: IMPLEMENTED
%% USE CASE: Ghi nhận lượt vào cửa cơ sở
%% SOURCE: BE/src/modules/facility-visits/facility-visits.service.ts
%% SOURCE: BE/src/modules/facility-visits/facility-visits.routes.ts
%% SOURCE: FE/src/shared/FacilityVisits.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% UI sends method QR but does not decode a JWT in this use case. This is distinct from class attendance.
%% Receptionist uses POST /facility-visits/reception-check-in for the selected member.
sequenceDiagram
    actor A as Member
    participant UI as FacilityVisits
    participant API as Express middleware / errorHandler
    participant C as facility-visits.controller.ts
    participant S as facilityVisitsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Press facility check-in button
    UI->>API: POST /api/v1/facility-visits/check-in
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(MEMBER), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: selfCheckIn(req, res, next)
        activate C
        C->>S: checkIn(memberProfileId, method, now)
        activate S
        S->>DB: Begin transaction, lock member check-in, read selected facility and current entitlement
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Require active facility and effective subscription including FREE, or approved class grant within the facility attendance window
        alt inactive facility or no current entitlement / approved term visit
            S->>DB: Roll back transaction
            S-->>C: 403 / 404
        else business conditions satisfied
            S->>DB: facilityVisit.findFirst for this member and facility within previous 5 minutes
            DB-->>S: Recent visit or none
            alt recent visit found
                S->>S: Reuse existing visit with duplicate true
            else no recent visit
                S->>DB: facilityVisit.create(memberId, facilityId, method, now)
                DB-->>S: New visit
            end
            S->>DB: Commit transaction
            S-->>C: Visit with duplicate indicator
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 201 new visit, 200 duplicate, or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

