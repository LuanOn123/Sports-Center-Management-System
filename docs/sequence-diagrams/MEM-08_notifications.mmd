%% STATUS: IMPLEMENTED
%% USE CASE: Xem thông báo và đánh dấu đã đọc
%% SOURCE: BE/src/modules/notifications/notifications.service.ts
%% SOURCE: BE/src/modules/notifications/notifications.routes.ts
%% SOURCE: FE/src/pages/member/NotificationsPage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% List and unread badge use GET /notifications and GET /notifications/unread-count.
%% PATCH /notifications/mark-all-read updates only the current user unread rows. No notification Socket.IO event is invented.
sequenceDiagram
    actor A as Member
    participant UI as NotificationsPage
    participant API as Express middleware / errorHandler
    participant C as notificationsController
    participant S as notificationsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Mark a notification as read
    UI->>API: PATCH /api/v1/notifications/:id/read
    activate API
    API->>API: authenticate
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: markRead(req, res, next)
        activate C
        C->>S: markNotificationRead(id, userId)
        activate S
        S->>DB: notification.findUnique(id)
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Require notification.userId equal authenticated userId
        alt notification missing or belongs to another user
            S-->>C: 404 / 403
        else business conditions satisfied
            S->>DB: notification.update(isRead true, readAt now)
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S-->>C: Updated own notification
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error
