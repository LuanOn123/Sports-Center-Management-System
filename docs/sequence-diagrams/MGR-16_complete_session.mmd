%% STATUS: IMPLEMENTED
%% USE CASE: Hoàn tất buổi học và ghi vắng mặc định
%% SOURCE: BE/src/modules/class-schedules/class-schedules.service.ts
%% SOURCE: BE/src/modules/class-schedules/class-schedules.routes.ts
%% SOURCE: FE/src/shared/Attendance.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Warnings are advisory and do not automatically apply penalties.
sequenceDiagram
    actor A as Center Manager
    participant UI as ResourcePage schedules
    participant API as Express middleware / errorHandler
    participant C as schedulesController
    participant S as schedulesService
    participant DB as Prisma / PostgreSQL

    A->>UI: Complete an ended teaching session
    UI->>API: PATCH /api/v1/class-schedules/:id/complete
    activate API
    API->>API: authenticate, checkFacilityScope, authorizeExact(MANAGER), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: completeSchedule(req, res, next)
        activate C
        C->>S: completeSchedule(id)
        activate S
        S->>DB: Read initial schedule, open locked transaction only when it is not COMPLETED
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Reject CANCELLED session, not-yet-ended session or concurrent completion
        alt schedule missing, cancelled, not ended or state changed
            S->>DB: Roll back transaction
            S-->>C: 400 / 404 / 409
        else already COMPLETED on initial read
            S-->>C: Existing completed schedule without new writes
        else SCHEDULED and ended
            S->>DB: Create missing ABSENT rows with SYSTEM_NO_SHOW, change BOOKED to COMPLETED and CAS schedule to COMPLETED
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S->>DB: Commit transaction
            S->>S: Start best-effort attendance warning scan after commit
            S-->>C: Completed schedule
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% Request validation schemas (see route evidence): ScheduleIdSchema
