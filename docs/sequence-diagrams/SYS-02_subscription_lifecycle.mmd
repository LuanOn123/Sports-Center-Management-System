%% STATUS: IMPLEMENTED
%% USE CASE: Job kích hoạt gói chờ và hết hạn gói
%% SOURCE: BE/src/modules/subscriptions/subscription-lifecycle.service.ts
%% SOURCE: BE/src/modules/subscriptions/entitlement.service.ts
%% SOURCE: BE/src/server.ts
%% Internal background jobs run at boot then configured LIFECYCLE_INTERVAL_MS, currently 15 minutes.
%% Runtime entitlement reads also enforce timestamps without waiting for this persisted-state cleanup.
sequenceDiagram
    actor Timer as Server lifecycle timer
    participant Job as runSubscriptionLifecycleJobs
    participant S as subscriptionLifecycleService
    participant E as entitlementService
    participant DB as Prisma / PostgreSQL

    Timer->>Job: Run lifecycle iteration
    activate Job
    Job->>S: activateScheduledSubscriptions(now)
    activate S
    S->>DB: Read due SCHEDULED subscriptions
    DB-->>S: Due subscription candidates
    loop due subscription
        S->>E: activateDueSubscription under member lock
        activate E
        E->>DB: Verify SUCCESS funding, startDate and strict endDate greater than now
        DB-->>E: Current due subscription state
        alt valid due paid period
            E->>DB: Suspend replaced ACTIVE rights then CAS due period to ACTIVE
        else period already ended or no longer eligible
            E->>DB: Expire ended scheduled period where applicable, otherwise skip
        end
        E-->>S: Activated or skipped
        deactivate E
    end
    S-->>Job: Activated count
    deactivate S
    Job->>S: expireStaleSubscriptions, sendSubscriptionExpiryReminders, closeStaleSepayPendingPayments
    activate S
    S->>DB: Mark elapsed active periods EXPIRED and deduplicate expiry reminders
    S->>DB: CAS stale SEPAY PENDING orders to FAILED using configured TTL
    DB-->>S: Cleanup and reminder results
    S-->>Job: Expired, reminder and closed-order counts
    deactivate S
    Job-->>Timer: Iteration summary or logged error
    deactivate Job
