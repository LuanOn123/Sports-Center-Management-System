%% SOURCE: FE/src/pages/member/MyClassesPage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Actual code releases the old row provisionally before assertCanBook, inside the same rollbackable transaction.
%% No quota for a new Class is consumed because Class identity cannot change.
sequenceDiagram
    actor A as Member
    participant UI as MyClassesPage
    participant API as Express middleware / errorHandler
    participant C as enrollmentsController
    participant S as enrollmentsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Choose a different session of the same class
    UI->>API: POST /api/v1/enrollments/:id/transfer
    activate API
    API->>API: authenticate, checkFacilityScope, validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: transferEnrollment(req, res, next)
        activate C
        C->>S: transferEnrollment(id, targetScheduleId, userId, role)
        activate S
        S->>DB: Read own current booking and target session
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Require same Class, different future SCHEDULED target and Member cutoff
        S->>S: Under subscription / quota / class / schedule locks, recheck assertCanBook and retained grant
        alt ownership, time, class, capacity, membership, penalty or conflict validation fails
            S-->>C: 400 / 403 / 404 / 409
        else business conditions satisfied
            S->>DB: In one transaction CAS old BOOKED to CANCELLED
            S->>S: Revalidate target with quotaExemptClassId and existing grant
            S->>DB: Create or reactivate target BOOKED enrollment with valid source and grant
            DB-->>S: New target enrollment
            S->>DB: Commit, or roll back both changes if target validation fails
            S-->>C: Target enrollment
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% Request validation schemas (see route evidence): TransferEnrollmentSchema
