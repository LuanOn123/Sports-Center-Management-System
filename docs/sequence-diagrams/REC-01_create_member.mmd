%% SOURCE: FE/src/features/reception/members/MembersPage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% These are sequential writes to two stores, not a distributed atomic transaction. Later PostgreSQL failure can leave earlier Mongo records.
%% MANAGER is blocked for /members by app.ts despite broader route annotations.
sequenceDiagram
    actor A as Receptionist
    participant UI as MembersPage
    participant API as Express middleware / errorHandler
    participant C as membersController
    participant S as membersService
    participant DB as Mongo models / Prisma

    A->>UI: Enter member identity and training profile
    UI->>API: POST /api/v1/members
    activate API
    API->>API: authenticate, checkFacilityScope, deny MANAGER for members, authorize(RECEPTIONIST), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: createMember(req, res, next)
        activate C
        C->>S: createMember(data, creatorUser)
        activate S
        S->>DB: Read User by email and phone for duplicate detection
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Reject existing email or phone, validate optional date of birth
        alt duplicate identity or invalid member fields
            S-->>C: 400 / 409
        else business conditions satisfied
            S->>DB: Mongo transaction creates User and MemberProfile
            DB-->>S: Committed Mongo identities
            S->>DB: Create PostgreSQL User and MemberProfile projections
            S->>DB: ensureActiveFreeSubscription inside PostgreSQL transaction
            DB-->>S: FREE entitlement or provisioning failure
            S->>S: Dispatch best-effort MEMBER_REGISTERED notification
            S-->>C: Created member profile
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 201 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

