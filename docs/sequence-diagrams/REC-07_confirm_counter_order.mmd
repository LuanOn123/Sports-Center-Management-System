%% STATUS: IMPLEMENTED
%% USE CASE: Xác nhận đã thu tiền và cấp gói tại quầy
%% SOURCE: BE/src/modules/operations/operations.routes.ts
%% SOURCE: BE/src/modules/subscriptions/subscription-purchase.service.ts
%% SOURCE: FE/src/features/reception/payments/PaymentsPage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Repeated SUCCESS linked order returns existing payment without duplicate entitlement.
%% Cash has already been received when Receptionist confirms. This action does not perform a bank transfer.
sequenceDiagram
    actor A as Receptionist
    participant UI as OperationsPage orders
    participant API as Express middleware
    participant H as operations.routes handler
    participant S as subscriptionPurchaseService
    participant DB as Prisma / PostgreSQL
    A->>UI: Confirm actual collection and reason
    UI->>API: POST /api/v1/counter-orders/:id/confirm
    activate API
    API->>API: authenticate, checkFacilityScope, authorizeExact(RECEPTIONIST), validate reason
    alt request rejected
        API-->>UI: 400 / 401 / 403
    else request accepted
        API->>H: Execute counter-order confirmation handler
        activate H
        H->>DB: Begin transaction, lock payment and read order with member and plan
        DB-->>H: Counter order or null
        alt not a counter order or plan missing
            H->>DB: Roll back transaction
            H-->>API: 404
        else SUCCESS already linked to subscription
            H-->>API: Existing payment without another entitlement
        else PENDING order with active member
            H->>DB: Lock member-subscription key
            H->>S: activateSubscriptionForPayment(tx, sold optionSnapshot)
            activate S
            S->>S: LockMemberSubscription and inspectPlanPurchase
            S->>DB: Read current rights and create subscription, collected SUCCESS payment, invoice and outbox if policy allows
            DB-->>S: Activation result or policy / persistence exception
            S-->>H: Subscription, payment and invoice or AppError
            deactivate S
            H->>DB: Commit only after successful activation
            H-->>API: Collection and rights result
        else invalid state or inactive member
            H->>DB: Roll back transaction
            H-->>API: 409
        end
        deactivate H
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show confirmed receipt or rejection
%% Helper failures throw before commit and roll back the transaction. No bank transfer is performed here.
%% This endpoint is used by OperationsPage kind orders, not PaymentsPage.
