%% STATUS: IMPLEMENTED
%% USE CASE: UI gửi tin nhắn HTTP và nhận sự kiện realtime
%% SOURCE: BE/src/modules/chat/chat.service.ts
%% SOURCE: BE/src/modules/chat/chat.controller.ts
%% SOURCE: BE/src/modules/chat/chat.routes.ts
%% SOURCE: BE/src/modules/chat/chat.socket.ts
%% SOURCE: FE/src/shared/Communication.tsx
sequenceDiagram
    actor A as Member
    participant UI as Communication
    participant API as Express / chatController
    participant S as chatService
    participant DB as Prisma / PostgreSQL
    participant IO as Socket.IO
    A->>UI: Send text message to contact
    UI->>API: POST /api/v1/chat/messages (FormData)
    activate API
    API->>API: authenticate, chatUploadSingle
    alt invalid authentication or empty content without file
        API-->>UI: 400 / 401
    else request accepted
        API->>S: createMessage(senderId from session, receiverId, content)
        activate S
        S->>DB: Read active sender and receiver identities
        DB-->>S: Roles and contact eligibility
        S->>S: assertCanContact and content length at most 5000
        alt invalid contact or content
            S-->>API: 400 / 403 / 404 error
        else message allowed
            S->>DB: chatMessage.create(isRead false)
            DB-->>S: Persisted message
            S->>S: Best-effort notifyReceiver for direct message
            S-->>API: Persisted message
            API->>IO: Emit newMessage to receiver room or all for common room
            IO->>UI: newMessage when this client is a recipient
        end
        deactivate S
        API-->>UI: 201 message or mapped error
    end
    deactivate API
    UI->>UI: Refresh chat queries on HTTP success or socket event
    UI-->>A: Show saved message or send failure
%% HTTP persistence succeeds even if best-effort socket emission fails.
