%% STATUS: IMPLEMENTED
%% USE CASE: Lập đơn bán gói tại quầy
%% SOURCE: BE/src/modules/operations/operations.routes.ts
%% SOURCE: FE/src/features/reception/payments/PaymentsPage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Actual collection confirmation is a separate request REC-07.
sequenceDiagram
    actor A as Receptionist
    participant UI as OperationsPage orders
    participant API as Express API middleware
    participant S as operationHandlers
    participant DB as Prisma / PostgreSQL

    A->>UI: Select member, paid plan and collection method
    UI->>API: POST /api/v1/counter-orders
    activate API
    API->>API: authenticate, checkFacilityScope, authorizeExact(RECEPTIONIST)
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>S: operationHandlers POST /counter-orders
        activate S
        S->>DB: Read active MEMBER profile and active paid membership plan
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Reject FREE and use server plan price, not client amount
        alt invalid member or paid plan
            S-->>API: 400
        else business conditions satisfied
            S->>DB: payment.create(status PENDING, server amount and sold-plan snapshots)
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S-->>API: Pending counter order without membership activation
        end
        deactivate S
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error
