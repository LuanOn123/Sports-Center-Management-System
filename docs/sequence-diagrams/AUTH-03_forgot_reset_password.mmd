%% STATUS: IMPLEMENTED
%% USE CASE: Yêu cầu OTP đặt lại mật khẩu
%% SOURCE: BE/src/modules/auth/auth.service.ts
%% SOURCE: BE/src/modules/auth/auth.routes.ts
%% SOURCE: BE/src/middlewares/passwordResetLimit.ts
%% SOURCE: BE/src/utils/mailer.ts
%% SOURCE: FE/src/features/auth/ForgotPassword.tsx
%% Actual mail driver depends on configuration. Do not assume SMTP in every environment.
%% No OTP value, hash value or real address appears. Unknown identity and cooldown use generic success.
sequenceDiagram
    actor A as Guest
    participant UI as ForgotPassword
    participant API as Express middleware / errorHandler
    participant C as authController
    participant S as authService
    participant MG as Mongo User / rate counters
    participant Mail as configured mailer
    A->>UI: Request password reset code
    UI->>API: POST /api/v1/auth/forgot-password
    activate API
    API->>API: validate request, passwordResetLimit
    alt invalid body or rate limited
        API-->>UI: 400 / 429
    else request allowed
        API->>C: forgotPassword(req, res, next)
        activate C
        C->>S: forgotPassword(data)
        activate S
        S->>MG: User.findOne(email)
        MG-->>S: Active user or unknown / inactive identity
        alt unknown or inactive
            S-->>C: Generic success without sending code
        else active identity
            S->>S: Generate random OTP, SHA-256 hash and 5-minute expiry
            S->>MG: Conditional update reserves OTP only outside 60-second cooldown
            MG-->>S: modifiedCount
            alt cooldown prevents new code
                S-->>C: Generic success without another email
            else new code reserved
                S->>Mail: sendOtpEmail(email, otp)
                activate Mail
                Mail-->>S: Delivery submission or provider error
                deactivate Mail
                S-->>C: Generic success or 502 delivery error
            end
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 generic instruction or mapped error
    end
    deactivate API
    UI-->>A: Show instruction, cooldown or error

