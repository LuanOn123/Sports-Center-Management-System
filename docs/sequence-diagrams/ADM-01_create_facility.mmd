sequenceDiagram
    actor A as Admin
    participant UI as FacilityEditor
    participant API as Express middleware / errorHandler
    participant C as facilities.controller.ts
    participant DB as Prisma / PostgreSQL
    A->>UI: Submit creation form
    UI->>API: POST /api/v1/facilities
    activate API
    API->>API: authenticate, authorize(ADMIN), validate request
    alt request rejected
        API-->>UI: 400 / 401 / 403
    else request accepted
        API->>C: createFacility(req, res)
        activate C
        C->>DB: facility.create(data)
        activate DB
        DB-->>C: Created entity or persistence error
        deactivate DB
        alt persistence fails
            C-->>API: Conflict or mapped database error
        else persistence succeeds
            C-->>API: Created entity
        end
        deactivate C
        API-->>UI: Creation response or mapped error
    end
    deactivate API
    UI-->>A: Show creation outcome

