%% SOURCE: BE/src/modules/enrollments/enrollments.service.ts
%% SOURCE: BE/src/modules/enrollments/enrollments.routes.ts
%% SOURCE: BE/src/modules/waitlist/waitlist.promotion.ts
%% SOURCE: FE/src/pages/member/MyClassesPage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Cancellation CAS failure returns 409. Promotion exceptions are caught by the current caller.
%% The promotion algorithm is detailed in SYS-01. Notification delivery failure does not undo cancellation.
sequenceDiagram
    actor A as Member
    participant UI as MyClassesPage
    participant API as Express middleware / errorHandler
    participant C as enrollmentsController
    participant S as enrollmentsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Cancel own future booked session
    UI->>API: DELETE /api/v1/enrollments/:id
    activate API
    API->>API: authenticate, checkFacilityScope
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: cancelEnrollment(req, res, next)
        activate C
        C->>S: cancelEnrollment(enrollmentId, userId, role)
        activate S
        S->>DB: Read owned BOOKED enrollment and schedule before cancellation
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Reject started sessions and enforce configured Member cancellation cutoff
        alt not owned, not BOOKED, started or cutoff passed
            S-->>C: 400 / 403 / 404
        else business conditions satisfied
            S->>DB: Begin transaction, lock quota / class / schedule and CAS BOOKED to CANCELLED
            DB-->>S: Cancelled enrollment or concurrent state conflict
            S->>S: Attempt promoteNextEligible on the released future session
            S->>DB: Commit cancellation and any successful promotion
            S-->>C: Cancelled enrollment and optional promotedEnrollmentId
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error
