%% STATUS: IMPLEMENTED
%% USE CASE: Chatbot trả lời bằng dữ liệu trung tâm
%% SOURCE: BE/src/modules/ai/ai.service.ts
%% SOURCE: BE/src/modules/ai/ai.routes.ts
%% SOURCE: BE/src/modules/ai/ai.schema.ts
%% SOURCE: FE/src/features/ai/AIChatBubble.tsx
%% Public API, no invented authentication or booking/payment mutation. Client-supplied history is handled as current code implements.
sequenceDiagram
    actor A as Guest
    participant UI as AIChatBubble
    participant API as Express middleware / errorHandler
    participant C as aiController
    participant S as aiService
    participant DB as Prisma / PostgreSQL
    participant AI as Groq

    A->>UI: Ask about center plans, sports or timetable
    UI->>API: POST /api/v1/ai/chat (message, history)
    activate API
    API->>API: validate request
    alt invalid body
        API-->>UI: 400 validation error
    else body valid
        API->>C: chat(req, res, next)
        activate C
        C->>S: chatWithAssistant(data)
        activate S
        S->>S: getSportsCenterPromptContext()
        S->>DB: facility, sport, class, membershipPlan, term and classSchedule.findMany
        DB-->>S: Live center context
        S->>S: Build system prompt, supplied history and current message
        alt Groq API configuration missing
            S-->>C: 503 AI not configured
        else provider configured
            S->>AI: chat.completions.create with configured model
            activate AI
            AI-->>S: Generated reply or provider failure
            deactivate AI
            alt provider failure
                S-->>C: 500 AI connection error
            else reply available
                S-->>C: reply text or configured empty-reply fallback
            end
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 reply or mapped error
    end
    deactivate API
    UI-->>A: Display answer or error

%% Request validation schemas (see route evidence): AiChatSchema
