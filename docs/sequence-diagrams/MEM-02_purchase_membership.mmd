%% STATUS: IMPLEMENTED
%% USE CASE: Hội viên tạo đơn thanh toán QR SePay
%% SOURCE: BE/src/modules/payments/sepay-payments.service.ts
%% SOURCE: BE/src/modules/payments/payments.routes.ts
%% SOURCE: BE/src/modules/subscriptions/subscription-purchase.service.ts
%% SOURCE: FE/src/shared/SepayCheckout.tsx
%% SOURCE: FE/src/shared/SepayCheckout.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Creating QR does not collect money or activate membership. Bank settlement is PAY-01. Polling is PAY-02.
sequenceDiagram
    actor A as Member
    participant UI as SepayCheckoutModal
    participant API as Express middleware / errorHandler
    participant C as paymentsController
    participant S as sepayPaymentsService
    participant P as subscriptionPurchaseService
    participant DB as Prisma / PostgreSQL
    A->>UI: Select paid plan and activation date
    UI->>API: POST /api/v1/payments/sepay/checkout
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(MEMBER), validate request
    alt request rejected
        API-->>UI: 400 / 401 / 403
    else request accepted
        API->>C: sepayCheckout(req, res, next)
        activate C
        C->>S: createSepayCheckout(userId, planId, startDate)
        activate S
        S->>S: isSepayConfigured and sepayConfig
        opt bank configuration available
            S->>DB: memberProfile.findUnique and membershipPlan.findUnique
            DB-->>S: Member, account state and paid plan
            opt active MEMBER and active positive-price non-FREE plan
                S->>P: inspectPlanPurchase(prisma, memberId, plan, startDate)
                activate P
                P->>DB: Read queued and current subscriptions
                DB-->>P: Purchase context
                P-->>S: NEW / RENEW_SAME_TIER / UPGRADE / DOWNGRADE or AppError
                deactivate P
            end
        end
        alt configuration, account, plan or purchase policy invalid
            S-->>C: 400 / 404 / 409 / 503
        else checkout eligible
            S->>DB: payment.findFirst for same member / plan PENDING SEPAY
            DB-->>S: Latest pending order or null
            alt existing unexpired pending order
                S-->>C: 409 SEPAY_PAYMENT_PENDING with existing checkout details
            else no unexpired pending order
                opt previous pending order expired
                    S->>DB: payment.update(previous status FAILED)
                end
                S->>S: planAmount, buildSepayPaymentCode and buildVietQrUrl
                S->>DB: payment.create(PENDING, server amount, sold snapshots, requested startDate)
                activate DB
                DB-->>S: Created order or persistence error
                deactivate DB
                S-->>C: Checkout view, or error if creation fails
            end
        end
        deactivate S
        C-->>API: sendCreated or next(error)
        deactivate C
        API-->>UI: 201 checkout or mapped error
    end
    deactivate API
    UI-->>A: Display QR and pending transfer instructions or error
%% NESTING_EXCEPTION: fourth frame is the optional expired-order close inside three independent guards.
%% Unique transactionCode collisions retry up to five times. No bank transfer or subscription is created here.
%% Settlement is PAY-01, subsequent polling/reconciliation is PAY-02. Money SUCCESS does not imply activation.

%% Request validation schemas (see route evidence): SepayCheckoutSchema
