%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Single-session POST /class-schedules delegates to the same batch helper.
sequenceDiagram
    actor A as Center Manager
    participant UI as ScheduleForm
    participant API as Express middleware / errorHandler
    participant C as schedulesController
    participant S as schedulesService
    participant DB as Prisma / PostgreSQL

    A->>UI: Confirm future class session slots
    UI->>API: POST /api/v1/class-schedules/batch
    activate API
    API->>API: authenticate, checkFacilityScope, authorizeExact(MANAGER), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: createScheduleBatch(req, res, next)
        activate C
        C->>S: createScheduleBatch(data)
        activate S
        S->>DB: Begin transaction, lock class assignment, room and Coaches, load schedules / term context
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Require 1 to 500 future non-overlapping sessions, one sport and one primary Coach
        S->>S: Validate room / expertise / leave / global conflicts and covering non-CLOSED term
        alt past or invalid time, unavailable resource, clash or invalid term
            S->>DB: Roll back transaction
            S-->>C: 400 / 404 / 409
        else business conditions satisfied
            S->>DB: classSchedule.createMany(status SCHEDULED)
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S->>DB: Commit transaction
            S-->>C: schedulesCreated
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 201 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

