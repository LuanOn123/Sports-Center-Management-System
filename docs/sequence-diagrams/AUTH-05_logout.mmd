%% STATUS: IMPLEMENTED
%% USE CASE: Đăng xuất phiên hiện tại
%% SOURCE: BE/src/modules/auth/auth.service.ts
%% SOURCE: BE/src/modules/auth/auth.routes.ts
%% SOURCE: FE/src/features/auth/Session.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% This endpoint revokes the supplied refresh record. It does not increment global tokenVersion.
sequenceDiagram
    actor A as User
    participant UI as Session
    participant API as Express middleware / errorHandler
    participant C as authController
    participant S as authService
    participant DB as Mongo RefreshToken

    A->>UI: Sign out current session
    UI->>API: POST /api/v1/auth/logout
    activate API
    API->>API: authenticate
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: logout(req, res, next)
        activate C
        C->>S: logout(refreshToken)
        activate S
        S->>DB: RefreshToken.findOne(hashToken(refreshToken))
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        alt refresh record missing
            S-->>C: 404
        else business conditions satisfied
            S->>DB: RefreshToken.updateOne(revokedAt now)
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S-->>C: Logged out
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error
