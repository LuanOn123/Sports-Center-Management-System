%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% See AUTH-01 for provisioning saga stages. This is not a distributed transaction.
%% Receptionist account creation has a separate /facilities/:facilityId/receptionists endpoint.
sequenceDiagram
    actor A as Center Manager
    participant UI as ManagerUsers
    participant API as Express middleware / errorHandler
    participant C as facilities.controller.ts
    participant S as usersService / provisioningService
    participant MG as Mongo User / role profile
    participant PG as Prisma / PostgreSQL
    A->>UI: Submit new COACH identity
    UI->>API: POST /api/v1/facilities/:facilityId/coaches
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(ADMIN, MANAGER), validate body
    alt request rejected
        API-->>UI: 400 / 401 / 403
    else request accepted
        API->>C: createFacilityCoach(req, res)
        activate C
        C->>PG: facility.findUnique(scoped facilityId)
        PG-->>C: Facility
        alt facility missing or inactive
            C-->>API: AppError 404
        else active facility
            C->>S: createUser(data with role COACH, facilityId)
            activate S
            S->>S: provisionAccount validates identity and role requirements
            S->>MG: Check duplicate email and recoverable provisioning lease
            MG-->>S: Identity and lease context
            S->>MG: If eligible persist inactive PENDING identity and role profile
            S->>PG: Upsert projection, role profile and FacilityStaff inside transaction
            PG-->>S: Provisioning outcome
            alt identity, role requirements or provisioning fails
                S->>S: Reject duplicate or perform implemented FAILED-state cleanup
                S-->>C: 400 / 409 / 503
            else both stores ready
                S->>MG: Set active READY
                S->>PG: Mark projection active
                S->>MG: Clear provisioning lease
                S-->>C: Safe created account DTO
            end
            deactivate S
            C-->>API: sendSuccess with 201 or propagated error
        end
        deactivate C
        API-->>UI: 201 account or mapped error
    end
    deactivate API
    UI-->>A: Show created staff or error
%% Provisioning stages short-circuit on rejection. No PENDING identity is created for a rejected duplicate.
%% COACH additionally validates active sportIds and facility Coach limits. Receptionist has no invented Coach constraints.
%% Cross-store provisioning is a recoverable saga, not a distributed atomic transaction.
