%% STATUS: IMPLEMENTED
%% USE CASE: Khiếu nại quyết định chuyên cần
%% SOURCE: BE/src/modules/attendance/attendance-penalties.service.ts
%% SOURCE: BE/src/modules/attendance/attendance.routes.ts
%% SOURCE: FE/src/pages/member/AttendancePage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
sequenceDiagram
    actor A as Member
    participant UI as AttendancePage
    participant API as Express middleware / errorHandler
    participant C as attendance.controller.ts
    participant S as attendancePenaltiesService
    participant DB as Prisma / PostgreSQL

    A->>UI: Submit own penalty appeal with reason
    UI->>API: POST /api/v1/attendance/penalties/:id/appeal
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(MEMBER), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: appealPenalty(req, res, next)
        activate C
        C->>S: appealPenalty(penaltyId, memberUserId, reason)
        activate S
        S->>DB: attendancePenalty.findUnique with member ownership
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Require own APPLIED penalty, no previous appeal and deadline within 72 hours
        alt not owned, missing, wrong state, repeated appeal or deadline passed
            S-->>C: 400 / 403 / 404 / 409
        else business conditions satisfied
            S->>DB: attendancePenalty.update(appealReason, appealedAt)
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S->>S: Schedule best-effort notification to deciding Manager
            S-->>C: Recorded appeal without automatic penalty removal
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% Request validation schemas (see route evidence): PenaltyAppealSchema
