%% STATUS: IMPLEMENTED
%% USE CASE: Gửi nhắc lịch học sắp tới
%% SOURCE: BE/src/modules/notifications/notifications.service.ts
%% SOURCE: BE/src/modules/notifications/notifications.routes.ts
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% API-only trigger, no specific UI button has been verified. No invented email or Socket.IO delivery.
sequenceDiagram
    actor A as Receptionist
    participant UI as API client
    participant API as Express middleware / errorHandler
    participant C as notificationsController
    participant S as notificationsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Trigger upcoming-class reminder processing
    UI->>API: POST /api/v1/notifications/trigger-upcoming-reminders
    activate API
    API->>API: authenticate, authorize(MANAGER, RECEPTIONIST)
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: triggerUpcomingReminders(req, res, next)
        activate C
        C->>S: sendUpcomingClassReminders()
        activate S
        S->>DB: Read all-facility sessions in next 24 hours and existing reminders
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Read-before-create deduplication, no unique reminder claim
        alt unauthorized request or database operation fails
            S-->>C: 403 or persistence error
        else business conditions satisfied
            S->>DB: Create UPCOMING_CLASS notifications only when no matching recent reminder exists
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S-->>C: Reminder processing result
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% IMPLEMENTATION_GAP: HTTP trigger has no facility context and reads all facilities. Deduplication is read-before-create, not concurrent idempotency.
