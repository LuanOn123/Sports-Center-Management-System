%% STATUS: IMPLEMENTED
%% USE CASE: Giao thức Socket.IO sendMessage đã triển khai
%% SOURCE: BE/src/modules/chat/chat.socket.ts
%% SOURCE: BE/src/modules/chat/chat.service.ts
%% SOURCE: FE/src/shared/Communication.tsx
%% API-only send protocol. Current Communication UI sends messages over HTTP and uses sockets to receive events.
%% Handshake verifies current JWT, identity version, role and readiness before this handler.
sequenceDiagram
    actor A as Member
    participant UI as Socket API client
    participant IO as Socket.IO chat.socket
    participant S as chatService
    participant DB as Prisma / PostgreSQL
    participant Peer as Receiver socket room

    A->>UI: Send message to permitted contact
    UI->>IO: sendMessage(receiverId, content) with acknowledgement
    activate IO
    IO->>S: createMessage(authenticated senderId, receiverId, content)
    activate S
    S->>DB: Read sender and receiver roles and active states
    DB-->>S: Current contact eligibility
    S->>S: assertCanContact and validate nonempty content length at most 5000
    alt inactive contact, forbidden role pair, self-contact or invalid content
        S-->>IO: AppError
        IO-->>UI: ack with ok false and error
    else message allowed
        S->>DB: chatMessage.create(isRead false)
        activate DB
        DB-->>S: Saved message
        deactivate DB
        S->>S: Best-effort notifyReceiver for direct message
        S-->>IO: Persisted message
        IO->>Peer: newMessage(message)
        IO->>UI: messageSent(message)
        IO-->>UI: ack with ok true
    end
    deactivate S
    deactivate IO
    UI-->>A: Display persisted message or send failure
%% Authentication failure is connect_error during handshake, before any sendMessage handler runs.
%% For room-wide messages receiverId is absent and server broadcasts to other sockets.
