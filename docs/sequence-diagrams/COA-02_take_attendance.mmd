%% SOURCE: BE/src/modules/attendance/attendance.service.ts
%% SOURCE: BE/src/modules/attendance/attendance.routes.ts
%% SOURCE: FE/src/shared/Attendance.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Unique scheduleId / memberId prevents a second attendance row. Member self-scan is MEM-07.
sequenceDiagram
    actor A as Coach
    participant UI as Attendance
    participant API as Express middleware / errorHandler
    participant C as attendance.controller.ts
    participant S as attendanceService
    participant DB as Prisma / PostgreSQL

    A->>UI: Record attendance status for enrolled member
    UI->>API: POST /api/v1/attendance
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(COACH, MANAGER), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: createAttendance(req, res, next)
        activate C
        C->>S: createAttendance(data, user)
        activate S
        S->>DB: Read effective Coach assignment, schedule and member enrollment
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Require assigned Coach, active attendance window and BOOKED / COMPLETED enrollment
        S->>S: Coach cannot set EXCUSED, correction of existing attendance requires Manager
        alt wrong assignment, EXCUSED forbidden, closed window or no enrollment
            S-->>C: 400 / 403 / 404 / 409
        else business conditions satisfied
            S->>DB: attendance.create(data)
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S-->>C: Saved attendance
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 201 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% IMPLEMENTATION_GAP: createAttendance does not recheck paid subscription / term entitlement; the Member scan path does.

%% Request validation schemas (see route evidence): CreateAttendanceSchema
