%% SOURCE: BE/src/modules/waitlist/waitlist.service.ts
%% SOURCE: BE/src/modules/waitlist/waitlist.routes.ts
%% SOURCE: FE/src/shared/Waitlist.tsx
%% SOURCE: FE/src/shared/Waitlist.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Conditional CAS mutates no row on the failure branch. No pre-read availability guarantee is invented.
sequenceDiagram
    actor A as Member
    participant UI as Waitlist
    participant API as Express middleware / errorHandler
    participant C as waitlist.controller.ts
    participant S as waitlistService
    participant DB as Prisma / PostgreSQL

    A->>UI: Cancel own waiting entry
    UI->>API: DELETE /api/v1/waitlist/:id
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(MEMBER)
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: leaveWaitlist(req, res, next)
        activate C
        C->>S: cancelWaitlistEntry(entryId, memberProfileId)
        activate S
        S->>DB: waitlistEntry.updateMany CAS for own id, memberId and WAITING to CANCELLED
        activate DB
        DB-->>S: Updated row count
        deactivate DB
        S->>S: Require changed count equal one
        alt conditional update affects zero rows
            S-->>C: 404
        else business conditions satisfied
            S->>DB: waitlistEntry.findUnique(entryId)
            DB-->>S: Cancelled own entry
            S-->>C: Cancelled waitlist entry
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error
