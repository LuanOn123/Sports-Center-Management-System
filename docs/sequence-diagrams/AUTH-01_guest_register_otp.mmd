%% STATUS: IMPLEMENTED
%% USE CASE: Đăng ký tài khoản hội viên, chưa có OTP đăng ký
%% SOURCE: BE/src/modules/auth/auth.service.ts
%% SOURCE: BE/src/modules/auth/auth.routes.ts
%% SOURCE: BE/src/modules/users/users.service.ts
%% SOURCE: BE/src/modules/users/provisioning.service.ts
%% SOURCE: FE/src/features/auth/Register.tsx
%% Checklist stem retained. Registration currently has NO OTP challenge or email verification step.
%% Mongo and PostgreSQL use a recoverable saga, not a distributed transaction.
sequenceDiagram
    actor A as Guest
    participant UI as Register
    participant API as Express middleware / errorHandler
    participant C as authController
    participant S as authService / usersService
    participant MG as Mongo User / MemberProfile
    participant PG as Prisma / PostgreSQL

    A->>UI: Submit identity, password and training preferences
    UI->>API: POST /api/v1/auth/register
    activate API
    API->>API: validate request
    alt invalid registration fields
        API-->>UI: 400 validation error
    else valid request
        API->>C: register(req, res, next)
        activate C
        C->>S: register(data), createUser with role MEMBER
        activate S
        S->>MG: provisionAccount reads duplicate identity and provisioning lease
        activate MG
        MG-->>S: Existing account or recoverable provisioning state
        deactivate MG
        alt duplicate READY identity or busy provisioning lease
            S-->>C: 409 identity / provisioning conflict
        else new account or permitted retry
            S->>MG: Commit Mongo User and MemberProfile with inactive PENDING state
            S->>PG: Transaction upserts identity and member projection, ensureActiveFreeSubscription
            activate PG
            PG-->>S: Projection transaction result
            deactivate PG
            alt projection or final readiness step fails
                S->>MG: Best-effort mark account inactive FAILED and clear lease
                S->>PG: Best-effort keep projection inactive
                S-->>C: Business error or 503 ACCOUNT_PROVISIONING_INCOMPLETE
            else both stores ready
                S->>MG: Set active READY and clear lease
                S->>PG: Set projection active
                S->>S: Dispatch best-effort MEMBER_REGISTERED notification
                S-->>C: Safe member identity DTO
            end
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 201 registered identity or mapped error
    end
    deactivate API
    UI-->>A: Show registration result

