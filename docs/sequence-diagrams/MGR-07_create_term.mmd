%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Admin may create global terms. Manager cannot create a global term.
sequenceDiagram
    actor A as Center Manager
    participant UI as AdminTerms
    participant API as Express middleware / errorHandler
    participant C as termsController
    participant S as termsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Enter term dates and registration window
    UI->>API: POST /api/v1/terms
    activate API
    API->>API: authenticate, authorize(ADMIN, MANAGER), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: createTerm(req, res, next)
        activate C
        C->>S: createTerm(data)
        activate S
        S->>DB: term.findUnique(code)
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Check duplicate term code after Controller resolved permitted facility
        alt duplicate term code or invalid date / scope
            S-->>C: 400 / 403 / 409
        else business conditions satisfied
            S->>DB: term.create with normalized dates and permitted facilityId
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S-->>C: Created term with counts
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 201 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% Request validation schemas (see route evidence): CreateTermSchema
