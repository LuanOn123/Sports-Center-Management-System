%% STATUS: IMPLEMENTED
%% USE CASE: Phân công HLV vào cơ sở
%% SOURCE: BE/src/modules/facilities/facilities.controller.ts
%% SOURCE: BE/src/modules/facilities/facilities.route.ts
%% SOURCE: FE/src/features/manage/ManagerUsers.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Manager assignment itself is Admin-only ADM-03. Admin cannot use this operation to invent another user role.
%% Removal uses DELETE /facilities/:facilityId/staff/:userId/:role with role-specific authorization.
sequenceDiagram
    actor A as Center Manager
    participant UI as AdminFacilities / ManagerUsers
    participant API as Express middleware / errorHandler
    participant C as facilities.controller.ts
    participant DB as Mongo User / Prisma

    A->>UI: Assign an eligible existing Coach to own facility
    UI->>API: POST /api/v1/facilities/:facilityId/staff
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(ADMIN, MANAGER), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: assignStaff(req, res)
        activate C
        C->>DB: Read active user and role, begin locked transaction and read global active staff assignment
        activate DB
        DB-->>C: Requested records and validation context
        deactivate DB
        C->>C: Require matching COACH identity, no current active facility assignment and facility Coach limit
        alt role / scope invalid, already assigned staff or facility limit reached
            C-->>API: 400 / 403 / 409
        else business conditions satisfied
            C->>DB: Create or reactivate scoped FacilityStaff assignment under transaction
            activate DB
            DB-->>C: Saved result
            deactivate DB
            C-->>API: Staff assignment
        end
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% Request validation schemas (see route evidence): AssignStaffSchema
