%% STATUS: IMPLEMENTED
%% USE CASE: Đôn danh sách chờ khi có chỗ
%% SOURCE: BE/src/modules/waitlist/waitlist.worker.ts
%% SOURCE: BE/src/modules/waitlist/waitlist.promotion.ts
%% SOURCE: BE/src/modules/enrollments/enrollments.service.ts
%% SOURCE: BE/src/server.ts
%% Internal worker, no human UI or fabricated HTTP API. Cancellation callers can invoke the same promotion helper.
%% Candidate lock or eligibility failure skips candidate without falsely cancelling the WAITING entry.
%% Each successful call claims at most one entry. Worker may repeat calls while capacity remains.
sequenceDiagram
    actor T as Server timer
    participant W as runWaitlistPromotions
    participant S as promoteNextEligible
    participant E as enrollmentsService
    participant DB as Prisma / PostgreSQL
    T->>W: Retry promotion every 60 seconds
    activate W
    W->>DB: Query future active sessions with WAITING entries and free seats
    DB-->>W: Available session candidates
    loop available schedule
        W->>DB: Begin transaction, try schedule lock and reread schedule
        DB-->>W: Fresh state and acquired flag
        alt busy, missing or closed schedule
            W->>W: Skip without promotion
        else locked future SCHEDULED session
            W->>S: promoteNextEligible(tx, scheduleId, schedule)
            activate S
            S->>DB: waitlistEntry.findMany(WAITING, position ascending)
            DB-->>S: Candidate queue
            loop candidate until first successful claim
                S->>DB: Savepoint and try subscription / quota / class locks
                DB-->>S: Acquired or busy
                opt candidate locks acquired
                    S->>S: activateMemberDue(tx, memberId)
                    S->>E: assertCanBook(tx, memberId, schedule)
                    activate E
                    E-->>S: Eligible subscription / old enrollment or rejection
                    deactivate E
                end
                alt candidate locks busy
                    S->>DB: Roll back to candidate savepoint and continue
                else candidate not eligible
                    S->>S: Keep WAITING and continue
                else candidate eligible
                    S->>DB: CAS WAITING to PROMOTED, create / reactivate BOOKED only if claim succeeds
                    DB-->>S: Promoted enrollment or lost claim
                    S->>S: enqueueNotification only for successful claim
                    S->>DB: Create corresponding outbox row only when promoted
                end
            end
            S-->>W: Promoted enrollment or null
            deactivate S
            W->>DB: Commit transaction
        end
    end
    W->>W: Flush notifications if any promotion succeeded
    W-->>T: Promoted count or error logged for later retry
    deactivate W
%% NESTING_EXCEPTION: worker loop, schedule guard, candidate loop and candidate guard require four frames.
%% Claim and write groups short-circuit when CAS count is not one. Skipped entries remain WAITING.
%% activateMemberDue is an entitlement helper invoked by promotion, not an enrollmentsService method.
