%% SOURCE: FE/src/features/manage/Dashboard.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% ADMIN inherits report access. Manager sees assigned facility only. Unreconciled historical refunds are exposed rather than silently verified.
sequenceDiagram
    actor A as Center Manager
    participant UI as ManagerRevenue / ManagerOverview
    participant API as Express middleware / errorHandler
    participant C as reportsController
    participant S as reportsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Select reporting date range
    UI->>API: GET /api/v1/reports/revenue
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(MANAGER), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: getRevenueReport(req, res, next)
        activate C
        C->>S: getRevenueReport(startDate, endDate)
        activate S
        S->>S: Use Vietnam day boundaries with offset +07:00
        S->>DB: Read payment aggregates, by-method groups, order counts and recent payments within facility scope
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Collected revenue uses paidAt, actual refunds use refundedAt, pending / failed orders use createdAt
        alt invalid date range or report query fails
            S-->>C: 400 or persistence error
        else business conditions satisfied
            S-->>C: Collected amount, actual refunds, net revenue and verification indicators
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% Request validation schemas (see route evidence): DateRangeSchema
