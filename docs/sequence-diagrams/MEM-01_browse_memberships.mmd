%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Catalog GET is public. Do not add login as a public browsing requirement.
sequenceDiagram
    actor A as Member
    participant UI as MembershipPage
    participant API as Express middleware / errorHandler
    participant C as plansController
    participant S as membershipPlansService
    participant DB as Prisma / PostgreSQL

    A->>UI: Browse paid membership plans
    UI->>API: GET /api/v1/membership-plans
    activate API
    API->>API: validate request, authenticate only when Authorization header supplied
    alt request guard rejects
        API-->>UI: 400 invalid query
    else request accepted
        API->>C: listPlans(req, res, next)
        activate C
        C->>S: listPlans(query, includeInactive)
        activate S
        S->>S: Exclude FREE from sale catalog and expose inactive plans only to authorized Admin
        S->>DB: membershipPlan.findMany and count with public active filter
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        alt query invalid or database read fails
            S-->>C: Validation or persistence error
        else business conditions satisfied
            S-->>C: Plans and pagination, including empty results
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% Request validation schemas (see route evidence): PlanQuerySchema
