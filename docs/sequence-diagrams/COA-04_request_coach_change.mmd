%% SOURCE: BE/src/modules/operations/operations.routes.ts
%% SOURCE: FE/src/features/operations/CoachChangesPage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Submitting does not replace schedule.coachId. Approval is MGR-17.
sequenceDiagram
    actor A as Coach
    participant UI as CoachChangesPage
    participant API as Express API middleware
    participant S as coachChangesService
    participant DB as Prisma / PostgreSQL

    A->>UI: Request replacement for own future session
    UI->>API: POST /api/v1/coach-change-requests
    activate API
    API->>API: authenticate, checkFacilityScope, authorizeExact(COACH), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>S: createCoachChange(user, input)
        activate S
        S->>DB: Begin transaction, resolve Coach, lock session and read pending requests
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Require own future SCHEDULED teaching session and no existing PENDING request
        alt not assigned, unavailable session, invalid reason or duplicate request
            S->>DB: Roll back transaction
            S-->>API: 400 / 403 / 404 / 409
        else business conditions satisfied
            S->>DB: coachChangeRequest.create plus Manager notification outbox rows
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S->>DB: Commit transaction
            S->>S: flushNotificationOutbox after commit, ignoring delivery failure
            S-->>API: Pending change request
        end
        deactivate S
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

