%% STATUS: IMPLEMENTED
%% USE CASE: Admin duyệt hoàn ngoại lệ chưa cấp quyền
%% SOURCE: BE/src/modules/payments/refunds.service.ts
%% SOURCE: BE/src/modules/payments/payments.routes.ts
%% SOURCE: FE/src/features/reception/payments/PaymentsPage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Approval blocks later activation. Actual refund confirmation is REC-05.
sequenceDiagram
    actor A as Admin
    participant UI as PaymentsPage
    participant API as Express API middleware
    participant S as refundsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Approve full refund request with reason
    UI->>API: POST /api/v1/payments/:id/refund/request
    activate API
    API->>API: authenticate, checkFacilityScope, authorizeExact(ADMIN), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>S: requestUnactivatedRefund(id, reason, actorId)
        activate S
        S->>DB: Begin transaction, lock payment and member, reread current payment
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Require SEPAY SUCCESS, no subscriptionId and REQUIRES_REVIEW
        S->>S: Amount is full server payment amount, repeated approval preserves original request
        alt payment missing or state not eligible
            S->>DB: Roll back transaction
            S-->>API: 404 / 409
        else business conditions satisfied
            alt refundRequestedAt already recorded
                S-->>API: Original approved request without overwriting reason
            else first valid request
                S->>S: requestRefund(tx, payment, server amount, reason)
                S->>DB: payment.update and auditLog.create with review actor
                activate DB
                DB-->>S: Saved result
                deactivate DB
                S->>DB: Commit transaction
                S-->>API: Approved refund request with payment still SUCCESS
            end
        end
        deactivate S
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

