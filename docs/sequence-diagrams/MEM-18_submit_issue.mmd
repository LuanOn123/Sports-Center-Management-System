%% SOURCE: BE/src/modules/operations/operations.routes.ts
%% SOURCE: BE/src/modules/operations/requesters.service.ts
%% SOURCE: FE/src/features/operations/OperationsPage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% The route returns sendSuccess with its default 200, not an invented 201.
sequenceDiagram
    actor A as Member
    participant UI as OperationsPage
    participant API as Express API middleware
    participant S as operationHandlers
    participant DB as Prisma / PostgreSQL

    A->>UI: Submit support issue at selected facility
    UI->>API: POST /api/v1/issues
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(MEMBER, COACH, RECEPTIONIST, MANAGER)
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>S: operationHandlers POST /issues
        activate S
        S->>S: Resolve actor and facility from requestContext
        S->>S: Validate title and description, reject embedded attendance violation reports
        alt invalid body or attempted attendance-report bypass
            S-->>API: 400
        else business conditions satisfied
            S->>DB: issue.create(requesterId, requesterRole, memberId for MEMBER, facilityId)
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S-->>API: New support issue
        end
        deactivate S
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error
