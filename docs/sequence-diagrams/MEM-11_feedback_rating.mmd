%% SOURCE: FE/src/shared/CoachFeedback.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Anonymous feedback hides member identity in listing. Future booking alone does not authorize a rating.
sequenceDiagram
    actor A as Member
    participant UI as CoachFeedback
    participant API as Express middleware / errorHandler
    participant C as feedbacks.controller.ts
    participant S as feedbacksService
    participant DB as Prisma / PostgreSQL

    A->>UI: Submit coach rating and optional class feedback
    UI->>API: POST /api/v1/feedbacks
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(MEMBER), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: createFeedback(req, res, next)
        activate C
        C->>S: createFeedback(data, userId)
        activate S
        S->>DB: Read own profile, active coach and past effective teaching attendance / completed enrollment
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Require past PRESENT / LATE attendance or COMPLETED enrollment for this coach and optional class
        alt member or coach missing, or no qualifying past session
            S-->>C: 404 / 403
        else business conditions satisfied
            S->>DB: coachFeedback.upsert for class, or locked create / update for general feedback
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S-->>C: Created or updated rating
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 201 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% Request validation schemas (see route evidence): CreateFeedbackSchema
