%% STATUS: IMPLEMENTED
%% USE CASE: Cập nhật kỳ học và trạng thái đăng ký
%% SOURCE: BE/src/modules/terms/terms.service.ts
%% SOURCE: BE/src/modules/terms/terms.routes.ts
%% SOURCE: FE/src/features/manage/AdminTerms.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% DELETE /terms/:id is separately guarded against dependent schedules / patterns and Manager global access.
sequenceDiagram
    actor A as Center Manager
    participant UI as AdminTerms
    participant API as Express middleware / errorHandler
    participant C as termsController
    participant S as termsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Edit term dates or move term status forward
    UI->>API: PATCH /api/v1/terms/:id
    activate API
    API->>API: authenticate, authorize(ADMIN, MANAGER), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: updateTerm(req, res, next)
        activate C
        C->>S: updateTerm(id, data, managerFacilityId)
        activate S
        S->>DB: Begin ambient transaction, lock term and read current term / dependencies
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Manager can only edit own facility term, cannot move scope
        S->>S: Reject backward or invalid status progression and dates excluding existing sessions
        alt missing term, wrong scope, duplicate code or invalid transition / dates
            S->>DB: Roll back term transaction
            S-->>C: 400 / 403 / 404 / 409
        else business conditions satisfied
            S->>DB: term.update(data)
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S->>DB: Commit term transaction
            S-->>C: Updated term
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error
%% Global Prisma delegates reuse the ambient transaction via BE/src/config/prisma.ts.

%% Request validation schemas (see route evidence): UpdateTermSchema
