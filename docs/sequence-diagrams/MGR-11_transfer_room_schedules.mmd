%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% Preview uses POST /rooms/:roomId/transfer-schedules/preview and does not reserve resources.
sequenceDiagram
    actor A as Center Manager
    participant UI as ManagerRooms
    participant API as Express middleware / errorHandler
    participant C as roomsController
    participant S as roomsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Select replacement room and confirm transfer after preview
    UI->>API: POST /api/v1/rooms/:roomId/transfer-schedules
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(MANAGER, RECEPTIONIST), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: transferSchedules(req, res, next)
        activate C
        C->>S: transferSchedules(sourceRoomId, input, actor)
        activate S
        S->>DB: Begin transaction, load overlapping SCHEDULED sessions and lock target room / Coaches
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Recheck every target resource, capacity, area and conflict before updating any session
        alt same room, invalid room, incompatible class or schedule conflict
            S->>DB: Roll back transaction
            S-->>C: 400 / 404 / 409
        else business conditions satisfied
            S->>DB: Update all candidate schedules to target room
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S->>DB: Commit transaction
            S->>S: Notify booked members after transaction commit with transfer metadata
            S-->>C: Moved sessions and source / target details
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% Request validation schemas (see route evidence): RoomIdSchema, TransferSchedulesSchema
