%% STATUS: IMPLEMENTED
%% USE CASE: Xác minh OTP và đặt mật khẩu mới
%% SOURCE: BE/src/modules/auth/auth.service.ts
%% SOURCE: BE/src/modules/auth/auth.routes.ts
%% SOURCE: FE/src/features/auth/ForgotPassword.tsx
%% Attempt reservation is a real mutation even for a wrong OTP. A failure does not change the password.
%% OTP consumption is compare-and-set. It cannot be reused by concurrent requests.
sequenceDiagram
    actor A as Guest
    participant UI as ForgotPassword
    participant API as Express middleware / errorHandler
    participant C as authController
    participant S as authService
    participant MG as Mongo User / RefreshToken
    participant IO as Socket.IO

    A->>UI: Submit OTP and new password
    UI->>API: POST /api/v1/auth/reset-password
    activate API
    API->>API: validate request, passwordResetLimit
    alt invalid body or rate limit reached
        API-->>UI: 400 / 429
    else request allowed
        API->>C: resetPassword(req, res, next)
        activate C
        C->>S: resetPassword(data)
        activate S
        S->>MG: findOneAndUpdate reserves attempt for active unexpired OTP with attempts below 5
        MG-->>S: Reserved User state or no qualifying record
        S->>S: Compare SHA-256 OTP hash and validate expiry
        alt missing, expired, wrong code or attempts exhausted
            S-->>C: 400 invalid or expired OTP
        else OTP matches
            S->>S: hashPassword(newPassword)
            S->>MG: Conditional update consumes matching unexpired OTP, changes password and increments tokenVersion
            MG-->>S: modifiedCount
            alt conditional consume loses race
                S-->>C: 400 invalid or expired OTP
            else consume succeeds once
                S->>MG: RefreshToken.deleteMany(userId)
                S->>IO: disconnectUserSockets(userId)
                S-->>C: Password reset completed
            end
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 reset result or mapped error
    end
    deactivate API
    UI-->>A: Prompt login with new password or show failure

