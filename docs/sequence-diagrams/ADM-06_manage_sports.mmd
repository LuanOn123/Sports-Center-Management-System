%% STATUS: IMPLEMENTED
%% USE CASE: Admin tạo bộ môn và yêu cầu thiết bị
%% SOURCE: BE/src/modules/sports/sports.service.ts
%% SOURCE: BE/src/modules/sports/sports.routes.ts
%% SOURCE: FE/src/features/manage/ResourcePage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% PATCH /sports/:id validates area / requirement changes against existing resources.
%% Deactivation refuses active classes. Requirements are not silently applied to class snapshots.
sequenceDiagram
    actor A as Admin
    participant UI as ResourcePage
    participant API as Express middleware / errorHandler
    participant C as sportsController
    participant S as sportsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Enter sport name, area types and equipment requirements
    UI->>API: POST /api/v1/sports
    activate API
    API->>API: authenticate, checkFacilityScope, authorize(ADMIN), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: createSport(req, res, next)
        activate C
        C->>S: createSport(data)
        activate S
        S->>DB: sport.findUnique(name)
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        alt duplicate sport name
            S-->>C: 409
        else business conditions satisfied
            S->>DB: sport.create with nested SubjectRequirement rows
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S-->>C: Created sport and requirements
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 201 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

%% Request validation schemas (see route evidence): CreateSportSchema
