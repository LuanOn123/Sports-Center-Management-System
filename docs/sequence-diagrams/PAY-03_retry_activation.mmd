%% STATUS: IMPLEMENTED
%% USE CASE: Admin cấp gói bù cho khoản đã thu đang đối soát
%% SOURCE: BE/src/modules/payments/sepay-payments.service.ts
%% SOURCE: BE/src/modules/payments/payments.routes.ts
%% SOURCE: BE/src/modules/subscriptions/subscription-purchase.service.ts
%% SOURCE: FE/src/features/reception/payments/PaymentsPage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
sequenceDiagram
    actor A as Admin
    participant UI as PaymentsPage
    participant API as Express middleware / errorHandler
    participant C as paymentsController
    participant S as sepayPaymentsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Retry activation for collected unactivated order
    UI->>API: POST /api/v1/payments/:id/retry-activation
    activate API
    API->>API: authenticate, checkFacilityScope, authorizeExact(ADMIN)
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>C: retryPaymentActivation(req, res, next)
        activate C
        C->>S: retrySepayActivation(adminUserId, paymentId)
        activate S
        S->>DB: Read initial payment / plan, then lock and reread inside activation transaction
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Require SEPAY SUCCESS, no linked subscription, REQUIRES_REVIEW and no approved refund
        S->>S: Use original sold-plan snapshot rather than current catalog terms
        alt not collected, already activated, refund approved or purchase policy rejects
            S->>DB: Roll back activation transaction if opened
            opt caught activation AppError
                S->>DB: payment.update(reviewReason) using global client after rollback
            end
            S-->>C: 400 / 404 / 409
        else business conditions satisfied
            S->>S: activateSubscriptionForPayment(tx, sold optionSnapshot)
            S->>DB: Persist linked subscription, invoice, ACTIVATED state and review actor fields
            activate DB
            DB-->>S: Saved result
            deactivate DB
            S->>DB: Commit transaction
            S-->>C: Activated / scheduled entitlement linked to already-collected payment
        end
        deactivate S
        C-->>API: response or next(error)
        deactivate C
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error
