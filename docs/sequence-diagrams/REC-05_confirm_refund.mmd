%% SOURCE: FE/src/features/reception/payments/PaymentsPage.tsx
%% HTTP prefix: /api/v1. API lane includes verified middleware and errorHandler.
%% Grouped read and validation calls short-circuit on error. No Repository layer is implied.
%% This records a completed refund, it does not call a bank payout API.
sequenceDiagram
    actor A as Receptionist
    participant UI as PaymentsPage
    participant API as Express API middleware
    participant S as paymentsService
    participant DB as Prisma / PostgreSQL

    A->>UI: Enter actual refund reason and bank / receipt reference
    UI->>API: POST /api/v1/payments/:id/refund/confirm
    activate API
    API->>API: authenticate, checkFacilityScope, authorizeExact(ADMIN, RECEPTIONIST), validate request
    alt request guard rejects
        API-->>UI: 400 / 401 / 403 error
    else request accepted
        API->>S: updatePaymentStatus(id, REFUNDED, confirmation)
        activate S
        S->>DB: Read payment with invoice and approved refund request
        activate DB
        DB-->>S: Requested records and validation context
        deactivate DB
        S->>S: Require collected SUCCESS or already REFUNDED payment and approved request
        S->>S: Require reason and real reference, repeated REFUNDED returns original receipt unchanged
        alt no approved request, invalid payment state or missing confirmation evidence
            S-->>API: 400 / 404 / 409
        else business conditions satisfied
            alt payment already REFUNDED
                S-->>API: Existing refund with original reference
            else first valid request
                S->>DB: Locked CAS transaction persists REFUNDED, refundedAmount, refundedAt and reference, cancels linked rights and invoice
                activate DB
                DB-->>S: Saved result
                deactivate DB
                S-->>API: Actual refund record
            end
        end
        deactivate S
        API-->>UI: 200 result or mapped error
    end
    deactivate API
    UI-->>A: Show result or actionable error

