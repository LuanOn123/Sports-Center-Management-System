{
  "expo": {
    "name": "Pulse | Sports Center",
    "slug": "pulse-sports-center",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "pulsecenter",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pulsecenter.mobile"
    },
    "android": {
      "package": "com.pulsecenter.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Pulse | Sports Center",
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Pulse cần quyền camera để quét mã QR điểm danh vào lớp học."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}