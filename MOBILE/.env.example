# ─── Sports Center Mobile App — Environment Variables ─────────────────────────
# Copy file này thành .env và điền giá trị phù hợp
# Expo yêu cầu tất cả biến public phải có prefix EXPO_PUBLIC_

# URL gốc của backend API (không có dấu / ở cuối)
EXPO_PUBLIC_API_BASE_URL=https://sports-center-management-system.onrender.com/api/v1

# Public Site Key cùng widget với web; không đưa Secret Key vào mobile.
EXPO_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAFSemj8jOA4n9j1n
# Origin của WebView cần được cho phép trong Cloudflare (Android/iOS).
EXPO_PUBLIC_TURNSTILE_ORIGIN=https://localhost

# Hiện nút "DEV: giả lập SePay đã thu tiền" ở màn thanh toán (chỉ có tác dụng ở bản dev
# và khi BE bật SEPAY_MOCK_MODE=true). Để trống/false khi build bản thật.
EXPO_PUBLIC_SEPAY_MOCK_MODE=false

# Token truy cập Expo (expo.dev → Account settings → Access tokens) để Expo CLI tự đăng nhập.
# KHÔNG có tiền tố EXPO_PUBLIC_ → chỉ CLI trên máy dùng, không bị đóng gói vào app.
# Chỉ điền vào file .env (đã gitignore) — tuyệt đối không commit token thật.
EXPO_TOKEN=

# ─── Đăng nhập / đăng ký bằng Google ──────────────────────────────────────────
# CHỈ chạy trên bản cài riêng (development build) — KHÔNG chạy trong Expo Go. Chưa điền thì nút Google vẫn hiện
# và báo "chưa dùng được"; đăng nhập email + mật khẩu không bị ảnh hưởng.
# Web client ID: dùng ĐÚNG giá trị của web (VITE_GOOGLE_CLIENT_ID) và BE (GOOGLE_CLIENT_ID) — BE chỉ nhận ID token
# có audience bằng giá trị này. OAuth client loại "Web application" (không phải Android/iOS).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID (OAuth client loại iOS, bundle id com.pulsecenter.mobile) — chỉ cần cho bản iOS.
# app.config.js suy ra URL scheme của iOS từ giá trị này (dạng 1234-abc.apps.googleusercontent.com).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
