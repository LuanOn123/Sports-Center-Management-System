# ─── Sports Center Mobile App — Environment Variables ─────────────────────────
# Copy file này thành .env và điền giá trị phù hợp
# Expo yêu cầu tất cả biến public phải có prefix EXPO_PUBLIC_

# URL gốc của backend API (không có dấu / ở cuối)
EXPO_PUBLIC_API_BASE_URL=https://sports-center-management-system.onrender.com/api/v1

# Hiện nút "DEV: giả lập SePay đã thu tiền" ở màn thanh toán (chỉ có tác dụng ở bản dev
# và khi BE bật SEPAY_MOCK_MODE=true). Để trống/false khi build bản thật.
EXPO_PUBLIC_SEPAY_MOCK_MODE=false

# Token truy cập Expo (expo.dev → Account settings → Access tokens) để Expo CLI tự đăng nhập.
# KHÔNG có tiền tố EXPO_PUBLIC_ → chỉ CLI trên máy dùng, không bị đóng gói vào app.
# Chỉ điền vào file .env (đã gitignore) — tuyệt đối không commit token thật.
EXPO_TOKEN=
