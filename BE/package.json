{
  "name": "sports-center-be",
  "version": "1.0.0",
  "private": true,
  "description": "Sports Center Management System Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:mongo": "tsx src/scripts/seed-mongo.ts",
    "db:seed:full": "tsx src/scripts/seed-full.ts",
    "db:backfill:free-subscription": "tsx prisma/backfill-free-subscription.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test:e2e": "tsx tests/enrollment-quota.e2e.ts",
    "test:e2e:attendance": "tsx tests/attendance-manual-code.e2e.ts",
    "test:e2e:course": "tsx tests/course-enrollment.e2e.ts",
    "test:e2e:sepay": "tsx tests/sepay-payment.e2e.ts",
    "test:e2e:chat": "tsx tests/chat-attachments.e2e.ts",
    "test:e2e:lifecycle": "tsx tests/subscription-lifecycle.e2e.ts",
    "test:sepay:smoke": "tsx tests/sepay-smoke.ts",
    "test:cloudinary:check": "tsx tests/cloudinary-check.ts",
    "test:mailer": "tsx tests/mailer-smoke.ts",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:attendance && npm run test:e2e:course && npm run test:e2e:sepay && npm run test:e2e:chat && npm run test:e2e:lifecycle",
    "predev": "npm run db:generate",
    "prebuild": "npm run db:generate",
    "test:operations": "tsx tests/facility-operations.integration.ts",
    "test:manager:isolation": "node tests/run-manager-isolation.mjs",
    "test:reception:isolation": "node tests/run-manager-isolation.mjs reception",
    "db:migrate:roles": "tsx src/scripts/migrate-staff-role.ts",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:identities": "tsx src/scripts/migrate-identity-projections.ts",
    "test:operations:http": "tsx tests/facility-http.integration.ts",
    "test:operations:migration": "tsx tests/facility-migration.integration.ts",
    "test:integration:audit": "tsx tests/integration-audit.ts",
    "test:integration:audit:browser": "tsx tests/integration-audit.ts --browser",
    "test:integration:room-ui": "tsx tests/browser-room-audit.ts",
    "test:operations:cross-facility": "tsx tests/cross-facility-booking.integration.ts",
    "test:operations:cross-facility-cancel": "tsx tests/cross-facility-cancel.integration.ts",
    "test:operations:cross-facility-my-schedule": "tsx tests/cross-facility-my-schedule.integration.ts",
    "test:operations:membership-reports": "tsx tests/membership-reports.integration.ts",
    "test:final:member-facility": "tsx tests/final-member-facility.integration.ts",
    "test:policy-a:membership": "tsx tests/policy-a-membership.integration.ts",
    "test:captcha": "tsx --test tests/turnstile.integration.test.ts"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "@prisma/client": "^5.22.0",
    "@types/mongoose": "^5.11.96",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.4",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "resend": "^6.30.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.22.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
