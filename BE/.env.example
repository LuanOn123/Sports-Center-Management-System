# Copy existing database/JWT configuration from your secure runtime environment.
DATABASE_URL=
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PORT=8080
# Required for ALL logins. Missing secret returns 503; never bypasses verification.
# Obtain the secret paired with the frontend public site key in Cloudflare.
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Exact trusted reverse-proxy hop count; keep 0 for direct/local serving.
# For a single trusted ingress proxy use 1 after checking deployment topology.
TRUST_PROXY_HOPS=0
