PORT=8080
DATABASE_URL="postgresql://user:password@localhost:5432/sport_center?schema=public"
# MongoDB must support transactions (replica set or MongoDB Atlas).
MONGO_URI="mongodb://localhost:27017/sports_center?replicaSet=rs0"
# Optional process-local DNS override, e.g. DNS_SERVERS="1.1.1.1,8.8.8.8"
DNS_SERVERS=""
JWT_ACCESS_SECRET="change_me"
JWT_REFRESH_SECRET="change_me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# VietQR + SePay (dùng tài khoản Test Mode cho đồ án)
SEPAY_WEBHOOK_API_KEY="copy_from_sepay_webhook_configuration"
VIETQR_BANK_ID="MB"
VIETQR_ACCOUNT_NO="your_bank_account_number"
VIETQR_ACCOUNT_NAME="NGUYEN VAN A"
VIETQR_PAYMENT_TTL_MINUTES=15
